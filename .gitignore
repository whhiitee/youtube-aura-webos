# Dependencies
node_modules/

# Build output (webpack). The packaged .ipk files in dist/ are committed for
# each release, everything else in it is rebuilt.
dist/*
!dist/*.ipk

# Release manifest written by `npm run manifest`
*.manifest.json

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.*

# Editors and operating systems
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local helpers from upstream 0.8.5's two-build setup (the modern build is gone)
_ipk_stash/
build-local modern*.cmd
build-local-perfmon.cmd

# npm run bundle:snapshot (tools/bundle-snapshot.mjs)
.bundle-snapshot/

# A baseline bundle built for the benchmarks (see docs/PERFORMANCE.md)
tests/bench/baseline/
